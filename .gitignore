Binaries/
DerivedDataCache/
Intermediate/
Saved/
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Packaged builds and logs
Builds/
*.log

# IDE and solution files (regenerated from the .uproject)
.vs/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# OS noise
.DS_Store
Thumbs.db


# Generated on each machine by prototypes/style/make_luts.py (kept out of git: binaries are not committed from the Mac)
prototypes/style/luts/*.png

# Python caches
__pycache__/
